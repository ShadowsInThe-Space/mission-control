# Mission Control docker-compose host settings
# Copy to deploy/.env and adjust for the target host.

# Safe default: expose Mission Control only on loopback.
MISSION_CONTROL_BIND_HOST=127.0.0.1
MISSION_CONTROL_HOST_PORT=3001

# In-container vault path used by Mission Control server code.
MISSION_CONTROL_MYWIKI_PATH=/data/mywiki

# Host path mounted into /data/mywiki inside the container.
MYWIKI_HOST_PATH=./data/mywiki

# Optional upstream services. Leave commented unless they exist on the target host.
# RANKFORGE_URL=http://127.0.0.1:13001
# RANKFORGE_API_KEY=
# FIRECRAWL_API_URL=http://127.0.0.1:3002
# LEPSY_HERMES_URL=http://127.0.0.1:18642
# BUZZ_RELAY_HTTP_URL=http://127.0.0.1:33110
# BUZZ_DEV_PUBKEY=
# OLLAMA_HOST=http://127.0.0.1:11434
