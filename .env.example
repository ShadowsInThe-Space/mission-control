# Mission Control — local environment configuration.
#
# Copy this file to `.env.local` and fill in the values that apply to your setup.
# All variables are read with `process.env.X` on the server side; missing values
# disable the corresponding feature rather than crashing the app.
#
# --- SEO feature services (RankForge + Firecrawl) ---

# RankForge local URL. Defaults to http://localhost:13001.
# RANKFORGE_URL=http://localhost:13001

# Required to actually trigger audits. Without it, /api/seo/scrape returns 503.
# RANKFORGE_API_KEY=replace-me

# Firecrawl local URL used by RankForge for crawling.
# FIRECRAWL_API_URL=http://localhost:3002

# --- Buzz relay ---
# Local Buzz relay base URL used by the Buzz feature agent in Mission Control.
# BUZZ_RELAY_HTTP_URL=http://127.0.0.1:33110

# SSH-tunnel-backed Hermes API for the secondary dev laptop `lepsy`.
# Default tunnel target used in this workspace: http://127.0.0.1:18642
# LEPSY_HERMES_URL=http://127.0.0.1:18642

# Dev-only Buzz pubkey header for local POST /query and POST /count requests.
# Required only when the relay is in local dev mode with X-Pubkey fallback auth.
# BUZZ_DEV_PUBKEY=

# --- Per-agent Buzz private keys (agent-to-agent communication) ---
# Each chat-capable agent gets its own Nostr secp256k1 private key so it can
# sign events (messages, reactions) on the Buzz relay. Generate with:
#   node scripts/gen-buzz-keys.mjs
# The values below are placeholders — run the script and copy your real keys.
# BUZZ_HERMES_KEY=
# BUZZ_OPENCLAW_KEY=
# BUZZ_CLAUDE_KEY=
# BUZZ_GEMINI_KEY=
# BUZZ_MMX_KEY=
# BUZZ_CODEX_KEY=
# BUZZ_ANTIGRAVITY_KEY=

# The shared Buzz channel UUID where agents communicate.
# Created by POST /api/buzz/bootstrap on first run.
# BUZZ_AGENT_CHANNEL_ID=

# --- NotebookLM MCP ---
# NOTEBOOKLM_MCP_URL=http://127.0.0.1:8766

# --- Content Studios (M2 adapters) ---
# BLOG_STUDIO_URL=http://127.0.0.1:8770
# IMAGE_STUDIO_URL=http://127.0.0.1:8771
# VIDEO_STUDIO_URL=http://127.0.0.1:8772
# PODCAST_STUDIO_URL=http://127.0.0.1:8773
# VISION_STUDIO_URL=http://127.0.0.1:8774

# --- Inference (chat-capable agents) ---
# Ollama local model server.
# OLLAMA_HOST=http://127.0.0.1:11434

# --- mywiki (cross-session memory) ---
# Path to the Obsidian vault. Defaults to /home/z3r0b1nary/workspace/mywiki.
# MISSION_CONTROL_MYWIKI_PATH=/home/z3r0b1nary/workspace/mywiki
